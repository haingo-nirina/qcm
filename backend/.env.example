# Copier ce fichier en .env et renseigner les valeurs
DATABASE_URL="postgres://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE?sslmode=require"

PORT=3001
# Origine autorisée pour le CORS (frontend Next.js)
FRONTEND_URL=http://localhost:3000

# Certificat CA Aiven (console Aiven > service > Overview > CA certificate)
DATABASE_CA_PATH=certs/aiven-ca.pem

# --- Production ---
# NODE_ENV=production        # active le cookie « Secure » (HTTPS obligatoire)
# TRUST_PROXY=1              # derrière un proxy (Nginx, hébergeur) : vraie IP du client pour la limite de tentatives
# COOKIE_DOMAIN=.qcm.mg      # si l'API et le site sont sur deux sous-domaines (api.qcm.mg / www.qcm.mg)

# Connexion des visiteurs avec Google (Client ID OAuth « Application Web », public)
GOOGLE_CLIENT_ID=
