# URL publique du site (balises SEO, sitemap.xml, liens de partage)
NEXT_PUBLIC_SITE_URL=https://www.exemple-qcm.mg

# URL de l'API (à utiliser dans src/services/ lors du branchement)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Pastille « Données d’exemple » du back-office : mettre false une fois l’API branchée
NEXT_PUBLIC_DONNEES_DEMO=true

# Compte Cloudinary des images des publications (autorisé dans next.config.ts)
CLOUDINARY_CLOUD_NAME=

# Connexion des visiteurs avec Google (Client ID OAuth « Application Web », public)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
